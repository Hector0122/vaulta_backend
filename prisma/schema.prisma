datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password      String
  refreshToken  String?
  createdAt     DateTime @default(now())

  photos    Photo[]
  albums    Album[]
  deviceTokens DeviceToken[]
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, token])
  @@index([userId])
}

model Album {
  id        String   @id @default(uuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  coverPhotoId String?
  photos    Photo[]
  vault     Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, vault])
}

model Photo {
  id        String   @id @default(uuid())

  s3Key     String   @unique
  thumbS3Key String?
  largeS3Key String?
  url       String

  filename  String
  mimeType  String
  size      Int

  favorite  Boolean  @default(false)
  tags      String[]
  blurred   Boolean  @default(false)
  blurScore Float?
  perceptualHash String?
  contentHash String?
  deletedAt DateTime?
  private   Boolean  @default(false)

  createdAt DateTime @default(now())

  userId    String
  user      User     @relation(fields: [userId], references: [id])
  albums    Album[]
  faces     Face[]

  @@index([userId, favorite])
  @@index([userId, createdAt])
  @@index([userId, deletedAt, createdAt])
  @@index([userId, deletedAt, private])
  @@index([userId, blurred])
  @@index([tags], type: Gin)
  @@index([perceptualHash])
  @@index([userId, contentHash])
}

model Face {
  id          String   @id @default(uuid())
  photoId     String
  photo       Photo    @relation(fields: [photoId], references: [id], onDelete: Cascade)
  encoding    Json
  boxX        Float
  boxY        Float
  boxWidth    Float
  boxHeight   Float
  personName  String?
  confirmed   Boolean  @default(false)
  ignored     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([photoId])
  @@index([personName])
  @@index([confirmed, ignored, personName])
  @@index([createdAt])
}
